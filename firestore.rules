rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function member() {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.email.lower() in get(/databases/$(database)/documents/access/hearth-hollow).data.emails;
  }
  match /kingdoms/hearth-hollow {
   allow get: if member();
   allow list, create, update, delete: if false;
  }
  // Only the Admin SDK in the callable function writes gameplay state.
  // Access list, rate counters, and receipts are never client-readable.
  match /{document=**} { allow read, write: if false; }
 }
}
